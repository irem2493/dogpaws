<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  <mapper namespace="com.dogpaws.backend.repository.dao.common.GubnDao">
    <select id="getGubnList" parameterType="String" resultType="com.dogpaws.backend.dto.common.GubnDto">
      SELECT group_code, gubn_code, gubn_name
      FROM tbl_gubn
      WHERE group_code = #{groupCode};
    </select>
</mapper>
