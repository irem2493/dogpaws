<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dogpaws.backend.repository.dao.rim.OrderDao">

    <!-- 주문 생성 -->
    <insert id="insertOrder" parameterType="com.dogpaws.backend.dto.rim.OrderDto" useGeneratedKeys="true" keyProperty="orderId">
        INSERT INTO tbl_orders (
            ql_id,
            username,
            total_price,
            order_name,
            order_phone,
            shipping_zipcode,
            shipping_address1,
            shipping_address2,
            shipping_extra_address,
            receiver_name,
            receiver_phone,
            shipping_memo,
            order_status,
            order_date
        ) VALUES (
            #{qlId},
            #{username},
            #{totalPrice},
            #{orderName},
            #{orderPhone},
            #{shippingZipcode},
            #{shippingAddress1},
            #{shippingAddress2},
            #{shippingExtraAddress},
            #{receiverName},
            #{receiverPhone},
            #{shippingMemo},
            #{orderStatus},
            NOW()
        )
</insert>
    <!-- 주문 상품 추가 -->
    <insert id="insertOrderItem" parameterType="com.dogpaws.backend.dto.rim.OrderItemDto" useGeneratedKeys="true" keyProperty="orderItemId">
        INSERT INTO tbl_order_items (
        ql_id,
        product_id,
        amount,
        item_price
        ) VALUES (
        #{qlId},
        #{productId},
        #{amount},
        #{itemPrice}
        )
    </insert>
    <!-- 주문 상품 옵션 추가 -->
    <insert id="insertOrderItemOption" parameterType="com.dogpaws.backend.dto.rim.OrderItemOptionDto">
        INSERT INTO tbl_order_item_options (
        order_item_id,
        option_name,
        option_price
        ) VALUES (
        #{orderItemId},
        #{optionName},
        #{optionPrice}
        )
    </insert>

    <!-- 주문 조회 -->
    <select id="selectOrderByQlId" resultMap="orderResultMap">
        SELECT
        o.order_id,
        o.ql_id,
        o.payment_key,
        o.username,
        o.total_price,
        o.order_name,
        o.order_phone,
        o.shipping_zipcode,
        o.shipping_address1,
        o.shipping_address2,
        o.shipping_extra_address,
        o.shipping_memo,
        o.receiver_name,
        o.receiver_phone,
        o.order_status,
        o.order_date,
        oi.order_item_id,
        oi.product_id,
        oi.amount,
        oi.item_price,
        oio.option_id,
        oio.option_name,
        oio.option_price
        FROM tbl_orders o
        LEFT JOIN tbl_order_items oi ON o.ql_id = oi.ql_id
        LEFT JOIN tbl_order_item_options oio ON oi.order_item_id = oio.order_item_id
        WHERE o.ql_id = #{qlId}
    </select>

    <!-- 주문 결과 매핑 -->
    <resultMap id="orderResultMap" type="com.dogpaws.backend.dto.rim.OrderDto">
        <id property="orderId" column="order_id"/>
        <result property="qlId" column="ql_id"/>
        <result property="paymentKey" column="payment_key"/>
        <result property="username" column="username"/>
        <result property="totalPrice" column="total_price"/>
        <result property="orderName" column="order_name"/>
        <result property="orderPhone" column="order_phone"/>
        <result property="shippingZipcode" column="shipping_zipcode"/>
        <result property="shippingAddress1" column="shipping_address1"/>
        <result property="shippingAddress2" column="shipping_address2"/>
        <result property="orderDate" column="order_date" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
        <result property="shippingExtraAddress" column="shipping_extra_address"/>
        <result property="shippingMemo" column="shipping_memo"/>
        <result property="receiverName" column="receiver_name"/>
        <result property="receiverPhone" column="receiver_phone"/>
        <result property="orderStatus" column="order_status"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>

        <collection property="orderItems" ofType="com.dogpaws.backend.dto.rim.OrderItemDto">
            <id property="orderItemId" column="order_item_id"/>
            <result property="qlId" column="ql_id"/>
            <result property="productId" column="product_id"/>
            <result property="amount" column="amount"/>
            <result property="itemPrice" column="item_price"/>

            <collection property="options" ofType="com.dogpaws.backend.dto.rim.OrderItemOptionDto">
                <id property="optionId" column="option_id"/>
                <result property="orderItemId" column="order_item_id"/>
                <result property="optionName" column="option_name"/>
                <result property="optionPrice" column="option_price"/>
            </collection>
        </collection>
    </resultMap>

    <!-- 주문번호 존재 여부 확인 -->
    <select id="existsByQlId" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM tbl_orders
        WHERE ql_id = #{qlId}
    </select>


    <!-- 주문 상태 업데이트 -->
    <update id="updateOrderStatus">
        UPDATE tbl_orders
        SET order_status = #{status}
        WHERE ql_id = #{qlId}
    </update>

    <!-- 결제키 업데이트 -->
    <update id="updatePaymentKey">
        UPDATE tbl_orders
        SET payment_key = #{paymentKey},
        order_status = 'PAID'
        WHERE ql_id = #{qlId}
    </update>

</mapper>
